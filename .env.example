# Environment Configuration for Evidence-Aware Research Agent
# Provide your Groq API key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini API key as fallback (free at https://aistudio.google.com)
GEMINI_API_KEY=

# Default Model Selection
PRIMARY_MODEL=llama-3.3-70b-versatile
# Fallback models: llama-3.1-8b-instant, gemini-2.0-flash

# Research & Recovery Budget Constraints
MAX_INITIAL_SEARCH_RESULTS=4
MAX_RECOVERY_ATTEMPTS=2
MAX_TOOL_CALLS_BUDGET=6

# Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./research_agent.db
